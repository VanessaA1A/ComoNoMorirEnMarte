    },
    {
      "id": "c06_atasco",
      "fondo": "bg_c06_atasco.jpg",
      "astro": "asustado",
      "zinnia": "alerta",
      "efecto": {
        "minutos": -20,
        "oxigeno": -10,
        "integridad": -10,
        "alimentacion": -10
      },
      "lineas": [
        {
          "quien": "Narración",
          "texto": "A mitad de camino, tus botas se hunden hasta el tobillo."
        },
        {
          "quien": "Zinn-IA",
          "texto": "¡No te muevas rápido! Respira despacio: así gastas menos oxígeno.",
          "expresion": "asustada"
        },
        {
          "quien": "Narración",
          "texto": "Tardas veinte minutos en salir. El traje tiene un raspón."
        },
        {
          "quien": "Zinn-IA",
          "texto": "La capa Terreno tenía razón. Lo anoto en la guía.",
          "expresion": "enojada"
        }
      ],
      "ir": "c06_03"
    },
    {
      "id": "c06_02a",
      "fondo": "bg_c06_hondonada.jpg",
      "astro": "caminando",
      "zinnia": "feliz",
      "lineas": [
        {
          "quien": "Zinn-IA",
          "texto": "¡Lo lograste! Cruzaste rápido, aunque la arena te cansó y rayó un poco el traje."
        }
      ],
      "ir": "c06_03"
    },
    {
      "id": "c06_02b",
      "fondo": "bg_c06_hondonada.jpg",
      "astro": "caminando",
      "zinnia": "feliz",
      "lineas": [
        {
          "quien": "Zinn-IA",
          "texto": "Camino largo pero seguro. Así planean las rutas de los rovers: primero la seguridad."
        }
      ],
      "ir": "c06_03"
    },
