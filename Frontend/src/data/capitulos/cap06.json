        {
          "quien": "Zinn-IA",
          "texto": "Eso indica arena suelta. Con el traje puedes hundirte o resbalar.",
          "expresion": "asustada"
        },
        {
          "quien": "Zinn-IA",
          "texto": "Si la rodeamos por el borde, el suelo es roca firme, pero el camino es el doble de largo.",
