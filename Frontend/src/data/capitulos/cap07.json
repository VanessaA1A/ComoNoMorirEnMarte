      "lineas": [
        { "quien": "Narración", "texto": "Paredes bajas de roca forman una red, como un panal, hasta donde alcanza la vista." },
        { "quien": "Zinn-IA", "texto": "¡Las crestas boxwork! Desde órbita parecen telarañas gigantes." },
        { "quien": "Zinn-IA", "texto": "Cada cresta mide de 1 a 2 metros de alto, y entre ellas hay hondonadas con arena." },
        { "quien": "Zinn-IA", "texto": "Curiosity encontró arcillas dentro de las crestas y bolitas minerales, del tamaño de un guisante, llamadas nódulos." },
        { "quien": "Zinn-IA", "texto": "La idea es que el agua subterránea cementó las grietas y después el viento erosionó la roca más blanda de alrededor." }
