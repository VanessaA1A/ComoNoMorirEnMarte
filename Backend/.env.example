# Copia este archivo como .env y pega ahí los valores reales. NUNCA subas el .env al repo.

# Neon → Connection string (conexión directa). La usan el servidor, db:schema y db:seed.
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
# Neon → Connection string con "Pooled connection" activado (host con -pooler). Opcional; hoy no se usa.
DATABASE_URL_POOLED=

# Orígenes permitidos, separados por coma, ej: http://localhost:5173,https://tu-juego.vercel.app
CORS_ORIGIN=http://localhost:5173
PORT=3001

# Zinn-IA (agente). La key va SOLO aquí y en el panel de Render; nunca en el frontend ni en variables VITE_.
ANTHROPIC_API_KEY=
ZINNIA_MODEL=claude-haiku-5-5
